rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // DB-1: Universal Default Deny All Client Reads and Writes
    // Client SDKs (web and admin) MUST NOT have direct read or write access to Firestore.
    // All access goes through the backend API via Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }

    // Orders: Deny direct client creation, update, and deletion (DB-1, ARCH-2)
    match /orders/{orderId} {
      allow create: if false;
      allow update, delete: if false;
    }

    // Inventory Logs: Backend Admin SDK only (DB-1)
    match /inventory_logs/{logId} {
      allow read, write: if false;
    }

    // Payment Transactions: Backend Admin SDK only (DB-1)
    match /payment_transactions/{txnId} {
      allow read, write: if false;
    }

    // Refunds: Backend Admin SDK only (DB-1, REFUND-1)
    match /refunds/{refundId} {
      allow read, write: if false;
    }

    // Audit Logs: Backend Admin SDK only (DB-1, LOG-2)
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Idempotency Records: Backend Admin SDK only
    match /idempotency/{id} {
      allow read, write: if false;
    }

    // Rate Limit Buckets: Backend Admin SDK only
    match /rate_limits/{bucket} {
      allow read, write: if false;
    }

    // Users: Client direct read/write strictly denied under DB-1, handled exclusively via backend API (AUTH-4)
    match /users/{userId} {
      allow read: if false;
      allow create, update: if false &&
        !('admin' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('roles' in request.resource.data) &&
        !('claims' in request.resource.data);
      allow delete: if false;
    }

    // Customers: Client direct read/write strictly denied under DB-1, handled exclusively via backend API (AUTH-4)
    match /customers/{userId} {
      allow read: if false;
      allow create, update: if false &&
        !('admin' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('roles' in request.resource.data) &&
        !('claims' in request.resource.data);
      allow delete: if false;
    }
  }
}
