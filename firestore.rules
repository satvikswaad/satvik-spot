rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // DB-1: Universal Default Deny All Client Reads and Writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Orders: Deny direct client creation, update, and deletion (DB-1, ARCH-2)
    match /orders/{orderId} {
      allow create: if false;
      allow update, delete: if false;
    }

    // Inventory Logs: Read only by verified admin, client writes strictly denied
    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Payment Transactions: Read only by admin, client writes strictly denied
    match /payment_transactions/{txnId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Refunds: Read only by admin, client writes strictly denied (REFUND-1)
    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Audit Logs: Read only by admin, client writes strictly denied (LOG-2)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Idempotency Records: Backend Admin SDK only
    match /idempotency/{id} {
      allow read, write: if false;
    }

    // Rate Limit Buckets: Backend Admin SDK only
    match /rate_limits/{bucket} {
      allow read, write: if false;
    }

    // TEMPORARY PATCH (Expires: 2026-11-27 - 14 days): Allow authenticated users to read/write ONLY their own profile with strict field whitelist and type/length validation until Wave E client API migration completes (DB-1, AUTH-4)
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'address', 'addresses', 'language', 'house', 'street', 'city', 'pincode', 'updatedAt', 'createdAt']) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() >= 2)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() >= 10)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$'))) &&
        !('admin' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('roles' in request.resource.data) &&
        !('claims' in request.resource.data) &&
        !('permissions' in request.resource.data);
      allow delete: if false;
    }

    match /customers/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'address', 'addresses', 'language', 'house', 'street', 'city', 'pincode', 'updatedAt', 'createdAt']) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() >= 2)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() >= 10)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$'))) &&
        !('admin' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('roles' in request.resource.data) &&
        !('claims' in request.resource.data) &&
        !('permissions' in request.resource.data);
      allow delete: if false;
    }
  }
}
