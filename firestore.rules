rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DB-1: firestore.rules denies ALL client reads and writes on EVERY collection.
    // The browser talks to the API only.
    // The Admin SDK in the two backend services is the only database client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
