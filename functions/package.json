{
  "name": "satwik-spot-functions",
  "version": "1.0.0",
  "description": "Server-authoritative backend pipeline for Satwik Sweets and Pickels",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "node node_modules/jest/bin/jest.js --config jest.config.js --runInBand"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^4.22.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "formidable": "^3.5.4",
    "superagent": "^10.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "asynckit": "^0.5.0",
    "bs-logger": "^0.2.6",
    "form-data": "^4.0.6",
    "jest": "^29.7.0",
    "source-map": "^0.7.6",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  }
}
