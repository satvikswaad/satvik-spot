# Server Runtime & Port Configuration
PORT=8080
NODE_ENV=staging
CORS_ALLOWED_ORIGINS=https://satvik-spot-staging.web.app,https://satvik-spot-staging-admin.web.app,http://localhost:3000,http://127.0.0.1:3000

# Firebase Application Default Credentials (Path to Secret File on Server)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Server-Authoritative Feature Gates (STAGING DEFAULT: FALSE)
COMMERCE_ENABLED=false
CHECKOUT_ENABLED=false
PAYMENTS_ENABLED=false
MARKETPLACE_AMAZON_ENABLED=false
MARKETPLACE_FLIPKART_ENABLED=false
PUBLIC_INDEXING_ENABLED=false

# Regulatory Compliance Identifiers (STAGING DEFAULT: PENDING)
FSSAI_STATUS=pending
FSSAI_NUMBER=
GST_STATUS=pending
GSTIN=

# Optional Marketplace Secrets (NEVER POPULATE IN GIT)
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
